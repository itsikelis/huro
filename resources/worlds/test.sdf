<?xml version="1.0" ?>
<sdf version="1.9">
<world name="lidar_test">

  <plugin filename="gz-sim-physics-system"
          name="gz::sim::systems::Physics"/>
  <plugin filename="gz-sim-scene-broadcaster-system"
          name="gz::sim::systems::SceneBroadcaster"/>
  <plugin filename="gz-sim-sensors-system"
          name="gz::sim::systems::Sensors">
    <render_engine>ogre2</render_engine>
  </plugin>
  <scene>
    <ambient>1 1 1 1</ambient>
    <background>0.8 0.8 0.8 1</background>
    <shadows>false</shadows>  <!-- shadows can cause render context issues -->
    </scene>

  <!-- ground as box, NOT plane -->
  <model name="ground">
    <static>true</static>
    <link name="link">
      <collision name="col">
        <pose>0 0 -0.05 0 0 0</pose>
        <geometry><box><size>100 100 0.1</size></box></geometry>
      </collision>
      <visual name="vis">
        <pose>0 0 -0.05 0 0 0</pose>
        <geometry><box><size>100 100 0.1</size></box></geometry>
      </visual>
    </link>
  </model>

  <!-- a wall right in front to guarantee hits -->
  <model name="wall">
    <static>true</static>
    <pose>2 0 1 0 0 0</pose>
    <link name="link">
      <collision name="col">
        <geometry><box><size>0.1 5 2</size></box></geometry>
      </collision>
      <visual name="vis">
        <geometry><box><size>0.1 5 2</size></box></geometry>
      </visual>
    </link>
  </model>

  <!-- lidar model, completely standalone -->
  <model name="lidar_model">
    <static>true</static>
    <pose>0 0 0.5 0 0 0</pose>
    <link name="lidar_link">
      <sensor name="gpu_lidar" type="gpu_lidar">
        <always_on>true</always_on>
        <update_rate>10</update_rate>
        <topic>/lidar</topic>
        <visualize>true</visualize>
        <lidar>
          <scan>
            <horizontal>
              <samples>640</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159</min_angle>
              <max_angle>3.14159</max_angle>
            </horizontal>
            <vertical>
              <samples>1</samples>
              <resolution>1</resolution>
              <min_angle>0</min_angle>
              <max_angle>0</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.08</min>
            <max>10.0</max>
            <resolution>0.01</resolution>
          </range>
        </lidar>
      </sensor>
    </link>
  </model>

</world>
</sdf>